{
  "name": "jm-commute",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "public-transport:prepare": "node --import tsx scripts/public_transport/prepare.ts",
    "public-transport:matrix": "node --import tsx scripts/public_transport/matrix.ts",
    "public-transport:verify": "node --import tsx scripts/public_transport/verify.ts",
    "car:osrm:prepare": "node --import tsx scripts/car/prepare-osrm.ts",
    "car:inspect": "node --import tsx scripts/car/inspect-car-routing.ts",
    "car:anchors:prepare": "node --import tsx scripts/car/prepare-locality-road-anchors.ts",
    "car:anchors:inspect": "node --import tsx scripts/car/inspect-locality-road-anchors.ts",
    "car:matrix:prepare": "node --import tsx scripts/car/prepare-travel-time-matrix.ts",
    "car:matrix:inspect": "node --import tsx scripts/car/inspect-travel-time-matrix.ts",
    "car:runtime:data": "node --import tsx scripts/car/build-runtime-car-data.ts",
    "car:runtime:verify": "node --import tsx scripts/car/verify-runtime-car-data.ts",
    "commute:package:data": "node --import tsx scripts/commute/publish-package-data.ts",
    "commute:package:build": "node --import tsx scripts/commute/build-commute-package.ts",
    "commute:package:pack": "node --import tsx scripts/commute/pack-commute-package.ts",
    "commute:package:verify": "node --import tsx scripts/commute/verify-packed-commute-package.ts",
    "commute:package:compression": "node --import tsx scripts/commute/benchmark-package-data-compression.ts",
    "commute:api:dev": "npm run dev --workspace @jm/commute-api",
    "commute:api:build": "npm run build --workspace @jm/commute && npm run build --workspace @jm/commute-api",
    "commute:api:start": "npm run commute:package:build && npm run build --workspace @jm/commute-api && npm run start --workspace @jm/commute-api",
    "commute:api:typecheck": "npm run build --workspace @jm/commute && npm run typecheck --workspace @jm/commute-api",
    "commute:api:verify": "npm run commute:package:build && node --import tsx scripts/commute-api/verify-commute-api.ts",
    "commute:api:benchmark": "npm run commute:package:build && node --import tsx scripts/commute-api/benchmark-commute-api.ts",
    "viewer:dev": "npm run dev --workspace @jm/commute-viewer",
    "viewer:build": "npm run build --workspace @jm/commute-viewer",
    "viewer:benchmark:payloads": "npm run commute:package:build && node --import tsx scripts/commute-viewer/benchmark-viewer-payloads.ts",
    "lint": "oxlint -D correctness -D suspicious --vitest-plugin --vue-plugin --deny-warnings src scripts packages/commute/src apps/commute-api/src apps/commute-viewer/src apps/commute-viewer/vite.config.ts vitest.config.ts",
    "test": "vitest run",
    "test:core": "vitest run --exclude 'apps/commute-viewer/**'",
    "typecheck:runtime": "tsc --noEmit -p packages/commute/tsconfig.json",
    "typecheck:core": "npm run typecheck:runtime && tsc --noEmit -p tsconfig.core.json && npm run commute:api:typecheck",
    "typecheck:viewer": "tsc --noEmit -p apps/commute-viewer/tsconfig.json",
    "typecheck": "npm run typecheck:core && npm run typecheck:viewer"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "oxlint": "^1.80.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "csv-parse": "^7.0.2"
  }
}
