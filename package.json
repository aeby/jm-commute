{
  "name": "jm-commute",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "data:prepare:stops": "tsx scripts/prepare-transit-stops.ts",
    "data:prepare:places": "tsx scripts/prepare-transit-places.ts",
    "data:prepare:service-profiles": "tsx scripts/prepare-transit-place-service-profiles.ts",
    "data:prepare:routing-trips": "tsx scripts/prepare-fixed-day-routing-trips.ts",
    "data:prepare:locality-routing-index": "tsx scripts/prepare-locality-routing-index.ts",
    "car:osrm:prepare": "tsx scripts/car/prepare-osrm.ts",
    "car:inspect": "tsx scripts/car/inspect-car-routing.ts",
    "car:anchors:prepare": "tsx scripts/car/prepare-locality-road-anchors.ts",
    "car:anchors:inspect": "tsx scripts/car/inspect-locality-road-anchors.ts",
    "car:matrix:prepare": "tsx scripts/car/prepare-travel-time-matrix.ts",
    "car:matrix:inspect": "tsx scripts/car/inspect-travel-time-matrix.ts",
    "car:runtime:data": "tsx scripts/car/build-runtime-car-data.ts",
    "car:runtime:verify": "tsx scripts/car/verify-runtime-car-data.ts",
    "car:runtime:inspect": "node --expose-gc --import tsx scripts/car/inspect-car-runtime.ts",
    "inspect:transit-candidates": "tsx scripts/inspect-transit-candidates.ts",
    "inspect:raptor-timetable": "node --expose-gc --import tsx scripts/inspect-raptor-timetable.ts",
    "inspect:raptor-reachability": "tsx scripts/inspect-raptor-reachability.ts",
    "inspect:locality-reachability": "tsx scripts/inspect-locality-reachability.ts",
    "inspect:commute-viewer": "tsx scripts/inspect-commute-viewer.ts",
    "viewer:data": "tsx scripts/build-commute-viewer-data.ts",
    "viewer:dev": "npm run viewer:data && npm run dev --workspace @jm/commute-viewer",
    "viewer:build": "npm run viewer:data && npm run build --workspace @jm/commute-viewer",
    "lint": "oxlint -D correctness -D suspicious --vitest-plugin --vue-plugin --deny-warnings src scripts apps/commute-viewer/src apps/commute-viewer/vite.config.ts vitest.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/commute-viewer/tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "oxlint": "^1.80.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "csv-parse": "^7.0.2"
  }
}
