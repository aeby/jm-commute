{
  "name": "jm-commute",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "data:prepare:stops": "node --import tsx scripts/transit/prepare-transit-stops.ts",
    "data:prepare:places": "node --import tsx scripts/transit/prepare-transit-places.ts",
    "data:prepare:service-profiles": "node --import tsx scripts/transit/prepare-transit-place-service-profiles.ts",
    "data:prepare:routing-trips": "node --import tsx scripts/transit/prepare-fixed-day-routing-trips.ts",
    "data:prepare:locality-routing-index": "node --import tsx scripts/transit/prepare-locality-routing-index.ts",
    "car:osrm:prepare": "node --import tsx scripts/car/prepare-osrm.ts",
    "car:inspect": "node --import tsx scripts/car/inspect-car-routing.ts",
    "car:anchors:prepare": "node --import tsx scripts/car/prepare-locality-road-anchors.ts",
    "car:anchors:inspect": "node --import tsx scripts/car/inspect-locality-road-anchors.ts",
    "car:matrix:prepare": "node --import tsx scripts/car/prepare-travel-time-matrix.ts",
    "car:matrix:inspect": "node --import tsx scripts/car/inspect-travel-time-matrix.ts",
    "car:runtime:data": "node --import tsx scripts/car/build-runtime-car-data.ts",
    "car:runtime:verify": "node --import tsx scripts/car/verify-runtime-car-data.ts",
    "transit:matrix:prepare": "node --import tsx scripts/transit/prepare-transit-travel-time-matrix.ts",
    "transit:matrix:inspect": "node --import tsx scripts/transit/inspect-transit-travel-time-matrix.ts",
    "transit:runtime:verify": "node --import tsx scripts/transit/verify-runtime-transit-data.ts",
    "commute:package:data": "node --import tsx scripts/commute/publish-package-data.ts",
    "commute:package:build": "node --import tsx scripts/commute/build-commute-package.ts",
    "commute:package:pack": "node --import tsx scripts/commute/pack-commute-package.ts",
    "commute:package:verify": "node --import tsx scripts/commute/verify-packed-commute-package.ts",
    "commute:package:compression": "node --import tsx scripts/commute/benchmark-package-data-compression.ts",
    "inspect:transit-candidates": "node --import tsx scripts/transit/inspect-transit-candidates.ts",
    "inspect:raptor-timetable": "node --expose-gc --import tsx scripts/transit/inspect-raptor-timetable.ts",
    "inspect:raptor-reachability": "node --import tsx scripts/transit/inspect-raptor-reachability.ts",
    "inspect:locality-reachability": "node --import tsx scripts/transit/inspect-locality-reachability.ts",
    "inspect:commute-viewer": "node --import tsx scripts/inspect-commute-viewer.ts",
    "viewer:data": "node --import tsx scripts/build-commute-viewer-data.ts",
    "viewer:dev": "npm run viewer:data && npm run dev --workspace @jm/commute-viewer",
    "viewer:build": "npm run viewer:data && npm run build --workspace @jm/commute-viewer",
    "lint": "oxlint -D correctness -D suspicious --vitest-plugin --vue-plugin --deny-warnings src scripts packages/commute/src apps/commute-viewer/src apps/commute-viewer/vite.config.ts vitest.config.ts",
    "test": "vitest run",
    "test:core": "vitest run --exclude 'apps/commute-viewer/**' --exclude 'scripts/__tests__/build-commute-viewer-data.test.ts'",
    "typecheck:runtime": "tsc --noEmit -p packages/commute/tsconfig.json",
    "typecheck:core": "npm run typecheck:runtime && tsc --noEmit -p tsconfig.core.json",
    "typecheck:viewer": "tsc --noEmit -p apps/commute-viewer/tsconfig.json",
    "typecheck": "npm run typecheck:core && npm run typecheck:viewer"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "oxlint": "^1.80.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "csv-parse": "^7.0.2"
  }
}
