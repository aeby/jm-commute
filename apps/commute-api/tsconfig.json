{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "dist",
    "declaration": false,
    "sourceMap": false,
    "noEmit": false,
    "paths": {
      // TypeScript selects the declarations; tsx selects the sibling JavaScript.
      "@jobmate/commute": ["../../packages/commute/dist/index"],
      "@jobmate/commute/node": ["../../packages/commute/dist/node"]
    },
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/__tests__/**"]
}
