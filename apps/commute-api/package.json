{
  "name": "@jobmate/commute-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "predev": "npm --prefix ../.. run commute:package:build",
    "dev": "node --watch --import tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@jobmate/commute": "*"
  },
  "engines": {
    "node": ">=20"
  }
}
